<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/screen_scroll"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">
        <com.example.myapplication.ContentColumn
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="620dp"
            android:layout_gravity="top|center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="19dp"
            android:paddingBottom="18dp"
            android:clipChildren="false"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="21dp">
                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_brand"
                    android:importantForAccessibility="no"
                    android:background="@drawable/bg_brand"
                    android:padding="7dp"
                    android:elevation="4dp" />
                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/student_portal"
                    android:textColor="@color/accent" />
            </LinearLayout>
            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_term" />
            <TextView
                style="@style/Text.PageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/screen_title"
                android:text="@string/welcome_dashboard"
                android:layout_marginTop="6dp"
                android:accessibilityHeading="true" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:clipToOutline="true"
                android:elevation="4dp"
                android:layout_marginTop="16dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="162dp"
                    android:src="@drawable/hero_lines"
                    android:scaleType="fitXY"
                    android:layout_gravity="top"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="17dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/student_record"
                            android:textColor="@color/hero_meta" />
                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/enrolled"
                            android:textColor="@color/green_ink"
                            android:background="@drawable/bg_pill"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <Space android:layout_width="1dp" android:layout_height="9dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            style="@style/Text"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:id="@+id/dashboard_avatar"
                            android:gravity="center"
                            android:background="@drawable/bg_hero_avatar"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-medium"
                            android:importantForAccessibility="no"
                            android:layout_marginEnd="11dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <TextView
                                style="@style/Text.Name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/dashboard_name"
                                android:textColor="@color/white"
                                android:textSize="21sp" />
                            <TextView
                                style="@style/Text.Small"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/dashboard_number"
                                android:textColor="@color/hero_meta"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        style="@style/Text.Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/dashboard_program"
                        android:textColor="@color/white"
                        android:layout_marginTop="11dp"
                        android:textSize="14sp" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/hero_line"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="11dp"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:paddingEnd="10dp">
                            <TextView
                                style="@style/Text.Small"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/year_level"
                                android:textColor="@color/hero_meta"
                                android:textSize="12sp" />
                            <TextView
                                style="@style/Text.Value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/dashboard_year"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <TextView
                                style="@style/Text.Small"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/specialization"
                                android:textColor="@color/hero_meta"
                                android:textSize="12sp" />
                            <TextView
                                style="@style/Text.Value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/dashboard_specialization"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <Space android:layout_width="1dp" android:layout_height="19dp" />
            <TextView
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/student_services"
                android:accessibilityHeading="true" />
            <Space android:layout_width="1dp" android:layout_height="9dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top"
                android:baselineAligned="false"
                android:clipToPadding="false"
                android:clipChildren="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/open_profile"
                    android:orientation="vertical"
                    android:gravity="top"
                    android:background="@drawable/ripple_card"
                    android:padding="12dp"
                    android:minHeight="112dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_id"
                            android:importantForAccessibility="no"
                            android:background="@drawable/bg_tile_blue"
                            android:padding="7dp"
                            app:tint="@color/accent" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@drawable/ic_next"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/student_profile"
                        android:layout_marginTop="7dp"
                        android:textSize="13sp" />
                    <TextView
                        style="@style/Text.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/student_profile_desc"
                        android:layout_marginTop="3dp"
                        android:textSize="12sp" />
                </LinearLayout>
                <Space android:layout_width="9dp" android:layout_height="1dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/open_academic"
                    android:orientation="vertical"
                    android:gravity="top"
                    android:background="@drawable/ripple_card"
                    android:padding="12dp"
                    android:minHeight="112dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_book"
                            android:importantForAccessibility="no"
                            android:background="@drawable/bg_tile_violet"
                            android:padding="7dp"
                            app:tint="@color/violet_ink" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@drawable/ic_next"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/academic_information"
                        android:layout_marginTop="7dp"
                        android:textSize="13sp" />
                    <TextView
                        style="@style/Text.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/academic_desc"
                        android:layout_marginTop="3dp"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="9dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top"
                android:baselineAligned="false"
                android:clipToPadding="false"
                android:clipChildren="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/open_enrollment"
                    android:orientation="vertical"
                    android:gravity="top"
                    android:background="@drawable/ripple_card"
                    android:padding="12dp"
                    android:minHeight="112dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_calendar"
                            android:importantForAccessibility="no"
                            android:background="@drawable/bg_tile_teal"
                            android:padding="7dp"
                            app:tint="@color/teal_ink" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@drawable/ic_next"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/enrollment_overview"
                        android:layout_marginTop="7dp"
                        android:textSize="13sp" />
                    <TextView
                        style="@style/Text.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/enrollment_desc"
                        android:layout_marginTop="3dp"
                        android:textSize="12sp" />
                </LinearLayout>
                <Space android:layout_width="9dp" android:layout_height="1dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/open_account"
                    android:orientation="vertical"
                    android:gravity="top"
                    android:background="@drawable/ripple_card"
                    android:padding="12dp"
                    android:minHeight="112dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_key"
                            android:importantForAccessibility="no"
                            android:background="@drawable/bg_tile_amber"
                            android:padding="7dp"
                            app:tint="@color/amber_ink" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@drawable/ic_next"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_information"
                        android:layout_marginTop="7dp"
                        android:textSize="13sp" />
                    <TextView
                        style="@style/Text.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_desc"
                        android:layout_marginTop="3dp"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.example.myapplication.ContentColumn>
    </FrameLayout>
</ScrollView>
