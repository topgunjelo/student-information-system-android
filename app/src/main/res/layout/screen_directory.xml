<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/screen_scroll"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">
        <com.example.myapplication.ContentColumn
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="620dp"
            android:layout_gravity="top|center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="19dp"
            android:paddingBottom="18dp"
            android:clipChildren="false"
            android:clipToPadding="false">
            <TextView
                style="@style/Text.PageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/directory"
                android:id="@+id/screen_title"
                android:accessibilityHeading="true" />
            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/directory_subtitle"
                android:layout_marginTop="6dp"
                android:id="@+id/screen_subtitle" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <EditText
                    style="@style/Input"
                    android:id="@+id/student_search"
                    android:hint="@string/search_hint"
                    android:inputType="text"
                    android:paddingStart="43dp"
                    android:paddingEnd="47dp"
                    android:textSize="14sp"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no" />
                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_search"
                    android:importantForAccessibility="no"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="14dp" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:id="@+id/clear_search"
                    android:contentDescription="@string/clear_search"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/ripple_action"
                    android:padding="13dp"
                    android:scaleType="centerInside"
                    android:layout_gravity="end|center_vertical"
                    android:visibility="gone" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <TextView
                    style="@style/Text.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/student_count"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite" />
                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Action.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/add_student"
                    android:text="@string/add_student"
                    android:drawableStart="@drawable/ic_plus"
                    android:drawableTint="@color/accent"
                    android:drawablePadding="5dp"
                    android:paddingEnd="4dp"
                    android:paddingStart="6dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/student_list"
                android:clipChildren="false"
                android:clipToPadding="false" />
            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/empty_results"
                android:visibility="gone"
                android:text="@string/no_results"
                android:paddingTop="20dp"
                android:paddingBottom="22dp"
                android:gravity="center" />
        </com.example.myapplication.ContentColumn>
    </FrameLayout>
</ScrollView>
