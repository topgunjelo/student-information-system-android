<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/screen_scroll"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">
        <com.example.myapplication.ContentColumn
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="620dp"
            android:layout_gravity="top|center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="19dp"
            android:paddingBottom="18dp"
            android:clipChildren="false"
            android:clipToPadding="false">
            <TextView
                style="@style/Text.PageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/student_profile"
                android:id="@+id/screen_title"
                android:accessibilityHeading="true" />
            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_subtitle"
                android:layout_marginTop="6dp"
                android:id="@+id/screen_subtitle" />
            <LinearLayout
                style="@style/Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        style="@style/Text"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:id="@+id/profile_avatar"
                        android:gravity="center"
                        android:background="@drawable/bg_profile_avatar"
                        android:textColor="@color/accent_dark"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif-medium"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="14dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <TextView
                            style="@style/Text.Name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/profile_name" />
                        <TextView
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/profile_number"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <LinearLayout
                style="@style/Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/personal_information"
                    android:accessibilityHeading="true"
                    android:layout_marginBottom="6dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/profile_fields" />
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="15dp" />
            <androidx.appcompat.widget.AppCompatButton
                style="@style/Action.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/edit_profile"
                android:text="@string/edit_profile" />
        </com.example.myapplication.ContentColumn>
    </FrameLayout>
</ScrollView>
