<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/screen_scroll"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">
        <com.example.myapplication.ContentColumn
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="620dp"
            android:layout_gravity="top|center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="19dp"
            android:paddingBottom="18dp"
            android:clipChildren="false"
            android:clipToPadding="false">
            <TextView
                style="@style/Text.PageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/edit_information"
                android:id="@+id/screen_title"
                android:accessibilityHeading="true" />
            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/form_subtitle"
                android:layout_marginTop="6dp"
                android:id="@+id/screen_subtitle" />
            <Space android:layout_width="1dp" android:layout_height="17dp" />
            <LinearLayout
                style="@style/Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp">
                <TextView
                    style="@style/Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_information"
                    android:accessibilityHeading="true" />
                <Space android:layout_width="1dp" android:layout_height="13dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="13dp">
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/username"
                        android:labelFor="@id/form_username"
                        android:layout_marginBottom="7dp" />
                    <EditText
                        style="@style/Input"
                        android:id="@+id/form_username"
                        android:hint="@string/username_hint"
                        android:inputType="textNoSuggestions"
                        android:importantForAutofill="no"
                        android:imeOptions="actionNext" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/password"
                        android:labelFor="@id/form_password"
                        android:layout_marginBottom="7dp" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <EditText
                            style="@style/Input"
                            android:id="@+id/form_password"
                            android:hint="@string/demo_password_hint"
                            android:inputType="textPassword"
                            android:paddingEnd="54dp"
                            android:saveEnabled="false"
                            android:importantForAutofill="no"
                            android:imeOptions="actionDone" />
                        <androidx.appcompat.widget.AppCompatImageButton
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:id="@+id/form_visibility"
                            android:contentDescription="@string/show_password"
                            android:src="@drawable/ic_eye"
                            android:background="@drawable/ripple_action"
                            android:padding="13dp"
                            android:scaleType="centerInside"
                            android:layout_gravity="end|center_vertical" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <LinearLayout
                style="@style/Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp">
                <TextView
                    style="@style/Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/personal_information"
                    android:accessibilityHeading="true" />
                <Space android:layout_width="1dp" android:layout_height="13dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="13dp">
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/student_number"
                        android:labelFor="@id/form_number"
                        android:layout_marginBottom="7dp" />
                    <EditText
                        style="@style/Input"
                        android:id="@+id/form_number"
                        android:hint="@string/student_hint"
                        android:inputType="textNoSuggestions"
                        android:imeOptions="actionNext" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="13dp">
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/last_name"
                        android:labelFor="@id/form_last"
                        android:layout_marginBottom="7dp" />
                    <EditText
                        style="@style/Input"
                        android:id="@+id/form_last"
                        android:hint="@string/last_name_hint"
                        android:inputType="textCapWords"
                        android:imeOptions="actionNext" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="13dp">
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/first_name"
                        android:labelFor="@id/form_first"
                        android:layout_marginBottom="7dp" />
                    <EditText
                        style="@style/Input"
                        android:id="@+id/form_first"
                        android:hint="@string/first_name_hint"
                        android:inputType="textCapWords"
                        android:imeOptions="actionNext" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="13dp">
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/optional_middle_name"
                        android:labelFor="@id/form_middle"
                        android:layout_marginBottom="7dp" />
                    <EditText
                        style="@style/Input"
                        android:id="@+id/form_middle"
                        android:hint="@string/middle_name_hint"
                        android:inputType="textCapWords"
                        android:imeOptions="actionNext" />
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <LinearLayout
                style="@style/Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp">
                <TextView
                    style="@style/Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/academic_information"
                    android:accessibilityHeading="true" />
                <Space android:layout_width="1dp" android:layout_height="13dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="13dp">
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/program"
                        android:labelFor="@id/form_program"
                        android:layout_marginBottom="7dp" />
                    <EditText
                        style="@style/Input"
                        android:id="@+id/form_program"
                        android:hint="@string/program_hint"
                        android:inputType="textCapWords"
                        android:imeOptions="actionNext" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="13dp">
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/optional_specialization"
                        android:labelFor="@id/form_specialization"
                        android:layout_marginBottom="7dp" />
                    <EditText
                        style="@style/Input"
                        android:id="@+id/form_specialization"
                        android:hint="@string/specialization_hint"
                        android:inputType="textCapWords"
                        android:imeOptions="actionDone" />
                </LinearLayout>
                <TextView
                    style="@style/Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/year_level"
                    android:labelFor="@id/form_year"
                    android:layout_marginBottom="7dp" />
                <androidx.appcompat.widget.AppCompatSpinner
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/form_year"
                    android:contentDescription="@string/year_level"
                    android:minHeight="52dp"
                    android:layout_marginBottom="8dp"
                    android:spinnerMode="dropdown"
                    android:dropDownWidth="match_parent"
                    android:background="@drawable/bg_spinner"
                    android:paddingEnd="39dp" />
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="15dp" />
            <androidx.appcompat.widget.AppCompatButton
                style="@style/Action.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/save_information"
                android:text="@string/save_information" />
            <Space android:layout_width="1dp" android:layout_height="4dp" />
            <androidx.appcompat.widget.AppCompatButton
                style="@style/Action.Link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/cancel_form"
                android:text="@string/cancel" />
        </com.example.myapplication.ContentColumn>
    </FrameLayout>
</ScrollView>
