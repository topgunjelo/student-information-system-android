<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/screen_scroll"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="264dp"
            android:src="@drawable/login_lines"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />
        <com.example.myapplication.ContentColumn
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="452dp"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="23dp"
            android:paddingBottom="23dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:focusableInTouchMode="true">
            <ImageView
                android:layout_width="59dp"
                android:layout_height="59dp"
                android:src="@drawable/ic_brand"
                android:importantForAccessibility="no"
                android:background="@drawable/bg_brand"
                android:padding="14dp"
                android:elevation="5dp" />
            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium" />
            <Space android:layout_width="1dp" android:layout_height="22dp" />
            <LinearLayout
                style="@style/Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="22dp"
                android:elevation="5dp">
                <TextView
                    style="@style/Text.LoginTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome"
                    android:accessibilityHeading="true" />
                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_intro"
                    android:layout_marginTop="6dp" />
                <Space android:layout_width="1dp" android:layout_height="21dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="13dp">
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/username"
                        android:labelFor="@id/login_username"
                        android:layout_marginBottom="7dp" />
                    <EditText
                        style="@style/Input"
                        android:id="@+id/login_username"
                        android:hint="@string/username_hint"
                        android:inputType="textNoSuggestions"
                        android:importantForAutofill="no"
                        android:imeOptions="actionNext" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/password"
                        android:labelFor="@id/login_password"
                        android:layout_marginBottom="7dp" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <EditText
                            style="@style/Input"
                            android:id="@+id/login_password"
                            android:hint="@string/password_hint"
                            android:inputType="textPassword"
                            android:paddingEnd="54dp"
                            android:saveEnabled="false"
                            android:importantForAutofill="no"
                            android:imeOptions="actionDone" />
                        <androidx.appcompat.widget.AppCompatImageButton
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:id="@+id/login_visibility"
                            android:contentDescription="@string/show_password"
                            android:src="@drawable/ic_eye"
                            android:background="@drawable/ripple_action"
                            android:padding="13dp"
                            android:scaleType="centerInside"
                            android:layout_gravity="end|center_vertical" />
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">
                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:id="@+id/remember_me"
                        android:text="@string/remember_me"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        android:paddingStart="0dp" />
                    <androidx.appcompat.widget.AppCompatButton
                        style="@style/Action.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/forgot_password"
                        android:text="@string/forgot_password"
                        android:paddingStart="6dp"
                        android:paddingEnd="4dp"
                        android:textSize="13sp" />
                </LinearLayout>
                <Space android:layout_width="1dp" android:layout_height="9dp" />
                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Action.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/sign_in"
                    android:text="@string/sign_in" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top"
                android:layout_marginTop="17dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_info"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="2dp"
                    app:tint="@color/accent" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/demo_title"
                        android:textSize="13sp" />
                    <TextView
                        style="@style/Text.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/demo_body"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>
        </com.example.myapplication.ContentColumn>
    </FrameLayout>
</ScrollView>
