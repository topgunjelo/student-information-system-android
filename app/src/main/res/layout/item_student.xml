<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass"
    android:padding="13dp"
    android:layout_marginBottom="9dp"
    android:elevation="2dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">
        <TextView
            style="@style/Text"
            android:layout_width="43dp"
            android:layout_height="43dp"
            android:id="@+id/directory_avatar"
            android:gravity="center"
            android:background="@drawable/bg_profile_avatar"
            android:textColor="@color/accent_dark"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:importantForAccessibility="no"
            android:layout_marginEnd="10dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                style="@style/Text.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/directory_name"
                android:textSize="16sp" />
            <TextView
                style="@style/Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/directory_number"
                android:layout_marginTop="3dp" />
            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/directory_program"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">
        <TextView
            style="@style/Text.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/directory_year"
            android:layout_weight="1"
            android:textColor="@color/accent"
            android:fontFamily="sans-serif-medium" />
        <androidx.appcompat.widget.AppCompatButton
            style="@style/Action.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/view_profile"
            android:text="@string/view_profile"
            android:drawableEnd="@drawable/ic_next"
            android:drawableTint="@color/accent"
            android:drawablePadding="2dp"
            android:paddingEnd="0dp"
            android:paddingStart="8dp" />
    </LinearLayout>
</LinearLayout>
